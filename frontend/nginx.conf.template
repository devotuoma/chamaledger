server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location /api/ {
        # Using a variable makes nginx look the host up again, so an upstream IP change
        # or a restart of the API does not leave the proxy pointing at a dead address.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $api_upstream ${API_URL};
        proxy_pass $api_upstream;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri /index.html;
    }
}
